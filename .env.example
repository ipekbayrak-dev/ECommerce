# JWT settings (shared across services)
Jwt__Secret=replace-with-32-plus-char-secret
Jwt__Issuer=ECommercePlatform
Jwt__Audience=ECommercePlatform
Jwt__ExpiryHours=24

# Stripe settings
Stripe__SecretKey=sk_test_replace-with-your-stripe-secret
Stripe__WebhookSecret=whsec_replace-with-your-webhook-secret
Stripe__Currency=usd

